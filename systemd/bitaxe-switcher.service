[Unit]
Description=Bitaxe Profit Switcher
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bitaxe-switcher
Group=bitaxe-switcher
EnvironmentFile=-/etc/bitaxe-switcher/environment
WorkingDirectory=/opt/bitaxe-switcher
ExecStart=/opt/bitaxe-switcher/venv/bin/python /opt/bitaxe-switcher/bitaxe_switcher.py --config /etc/bitaxe-switcher/config.yaml --state /var/lib/bitaxe-switcher/state.json --log /var/log/bitaxe-switcher.log auto
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bitaxe-switcher /var/log/bitaxe-switcher.log
